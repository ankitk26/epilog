{
	"name": "epilog",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"dev:web": "pnpm --filter web dev",
		"dev:convex": "pnpm --filter @epilog/backend dev",
		"dev:all": "concurrently -n vite,convex -c blue,green \"pnpm dev:web\" \"pnpm dev:convex\"",
		"build": "pnpm --filter web build",
		"types": "pnpm --filter web types",
		"check": "oxlint && oxfmt --write",
		"fmt": "oxfmt",
		"lint": "oxlint",
		"deploy:convex": "pnpm --filter @epilog/backend deploy:convex",
		"deploy:web": "pnpm --filter web deploy"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@epilog/config": "workspace:*",
		"@oxlint/plugins": "1.78.0",
		"concurrently": "^9.2.1",
		"oxfmt": "^0.55.0",
		"oxlint": "^1.78.0",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.14.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@tailwindcss/oxide",
			"esbuild",
			"workerd"
		]
	}
}
