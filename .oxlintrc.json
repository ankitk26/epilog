{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"ignorePatterns": [
		".agent/**",
		".agents/**",
		".claude/**",
		".codex/**",
		".continue/**",
		".cursor/**",
		".gemini/**",
		".opencode/**",
		".pi/**",
		".roo/**",
		".windsurf/**",
		"tools/oxlint/anti-slop/**"
	],
	"jsPlugins": [
		{
			"name": "anti-slop",
			"specifier": "./tools/oxlint/anti-slop/index.ts"
		},
		"@shadcn/lint"
	],
	"categories": {
		"correctness": "error"
	},
	"rules": {
		"anti-slop/no-chained-type-assertions": "error",
		"anti-slop/no-conditional-empty-object-spread": "error",
		"anti-slop/no-known-value-widening": "error",
		"anti-slop/no-module-mocking": "error",
		"anti-slop/no-object-parameters": "error",
		"anti-slop/no-reflect-apply": "error",
		"anti-slop/no-reflect-get": "error",
		"anti-slop/no-runtime-typeof": "error",
		"anti-slop/no-shape-in-symbol-names": "error",
		"anti-slop/no-unknown-parameters": "error",
		"anti-slop/no-unknown-returns": "error",
		"anti-slop/no-unknown-type-aliases": "error",
		"anti-slop/no-unsafe-dictionary-type": "error",
		"anti-slop/no-widen-then-assert": "error",
		"anti-slop/require-safety-comment-for-type-assertion": "error",
		"shadcn/no-arbitrary-values": [
			"error",
			{
				"allow": [
					"aspect-[2/3]",
					"min-h-*",
					"max-h-*",
					"max-w-*",
					"min-w-*",
					"grid-cols-*",
					"transition-*",
					"[--ui-*]",
					"[inset-*]",
					"h-[env(safe-area-inset-bottom)]",
					"sm:w-[calc(100%-3rem)]",
					"[top:calc(var(--media-type-nav-underline-top)+var(--media-type-nav-underline-height)+2px)]"
				]
			}
		],
		"shadcn/no-restyle": [
			"error",
			{
				"allow": [
					"layout",
					"color",
					"typography",
					"shape",
					"effects",
					"motion",
					"p-0",
					"p-1",
					"p-2",
					"p-3",
					"p-4",
					"p-6",
					"p-8",
					"px-0",
					"px-1",
					"px-2",
					"px-3",
					"px-4",
					"px-6",
					"px-8",
					"py-0",
					"py-1",
					"py-2",
					"py-3",
					"py-4",
					"py-6",
					"py-8",
					"pt-0",
					"pt-1",
					"pt-2",
					"pt-3",
					"pt-4",
					"pt-6",
					"pt-8",
					"pr-0",
					"pr-1",
					"pr-2",
					"pr-3",
					"pr-4",
					"pr-6",
					"pr-8",
					"pb-0",
					"pb-1",
					"pb-2",
					"pb-3",
					"pb-4",
					"pb-6",
					"pb-8",
					"pl-0",
					"pl-1",
					"pl-2",
					"pl-3",
					"pl-4",
					"pl-6",
					"pl-8",
					"m-0",
					"m-1",
					"m-2",
					"m-4",
					"m-6",
					"m-8",
					"mx-0",
					"mx-1",
					"mx-2",
					"mx-4",
					"mx-6",
					"mx-8",
					"my-0",
					"my-1",
					"my-2",
					"my-4",
					"my-6",
					"my-8",
					"mt-0",
					"mt-1",
					"mt-2",
					"mt-4",
					"mt-6",
					"mt-8",
					"mr-0",
					"mr-1",
					"mr-2",
					"mr-4",
					"mr-6",
					"mr-8",
					"mb-0",
					"mb-1",
					"mb-2",
					"mb-4",
					"mb-6",
					"mb-8",
					"ml-0",
					"ml-1",
					"ml-2",
					"ml-4",
					"ml-6",
					"ml-8",
					"gap-1",
					"gap-2",
					"gap-3",
					"gap-4",
					"gap-6",
					"gap-8",
					"gap-x-1",
					"gap-x-2",
					"gap-x-3",
					"gap-x-4",
					"gap-x-6",
					"gap-x-8",
					"gap-y-1",
					"gap-y-2",
					"gap-y-3",
					"gap-y-4",
					"gap-y-6",
					"gap-y-8",
					"space-x-2",
					"space-x-3",
					"space-x-4",
					"space-x-6",
					"space-x-8",
					"space-x-14",
					"space-x-20",
					"space-y-2",
					"space-y-3",
					"space-y-4",
					"space-y-6",
					"space-y-8",
					"space-y-14",
					"space-y-20",
					"[&_[data-slot=progress-track]]:h-1.5",
					"[&_[data-slot=progress-track]]:bg-secondary",
					"top-auto",
					"bottom-0",
					"left-0",
					"right-0",
					"inset-0",
					"top-1/2",
					"left-1/2",
					"-translate-x-1/2",
					"-translate-y-1/2",
					"translate-x-0",
					"translate-y-0",
					"safe-area-bottom"
				],
				"message": {
					"spacing": "use only the allowed spacing values (AGENTS.md): space-* 2|3|4|6|8|14|20, gap-* 1|2|3|4|6|8, p-* 0|1|2|3|4|6|8, m-* 0|1|2|4|6|8",
					"default": "use only the allowed spacing values (AGENTS.md): space-* 2|3|4|6|8|14|20, gap-* 1|2|3|4|6|8, p-* 0|1|2|3|4|6|8, m-* 0|1|2|4|6|8"
				}
			}
		]
	},
	"env": {
		"builtin": true
	},
	"overrides": [
		{
			"files": ["apps/web/src/components/ui/**"],
			"rules": {
				"shadcn/no-restyle": "off"
			}
		}
	]
}
