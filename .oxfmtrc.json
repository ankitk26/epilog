{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"packages/backend/convex/_generated/*",
		"apps/web/src/routeTree.gen.ts"
	],
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"sortImports": {
		"newlinesBetween": false
	},
	"sortTailwindcss": {
		"stylesheet": "./apps/web/src/styles/app.css",
		"functions": ["clsx", "cn"]
	}
}
