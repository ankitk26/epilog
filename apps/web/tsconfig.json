{
	"compilerOptions": {
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"module": "ESNext",
		"target": "ES2022",
		"skipLibCheck": true,
		"strict": true,
		"strictNullChecks": true,
		"paths": {
			"@/*": ["./src/*"],
			"@convex/*": ["../../packages/backend/convex/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
